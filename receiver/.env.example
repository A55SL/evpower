# Copy this file to .env and fill in your values.
# Never commit .env to git.

# GitHub Personal Access Token (classic, needs 'repo' scope)
GH_TOKEN=ghp_your_personal_access_token_here

# Your GitHub username or org name
GH_OWNER=your-github-username

# The repository name (this repo)
GH_REPO=evpower

# Public ngrok URL so GitHub Actions can call back to the receiver (no trailing slash)
# Run: ngrok http 8000  — then copy the https://...ngrok-free.app URL here
# Also add this as a GitHub Actions secret named RECEIVER_URL
RECEIVER_URL=https://your-ngrok-url-here
